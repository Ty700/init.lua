    ensure_installed = {
        "c", "cpp", "python", "ruby", "make", "cmake", "bash", "lua",
        "javascript", "html", "css", "vim", "vimdoc", "query", "markdown",
        "markdown_inline", "swift", "json", "yaml", "toml"
    },
    sync_install = false,
    auto_install = true,
    highlight = {
        enable = true,
        additional_vim_regex_highlighting = false,
    },
}
